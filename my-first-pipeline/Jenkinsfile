pipeline {
  agent {
    docker { image 'node:16-alpine' }
  }
  stages {
    stage('Test') {
      steps {
        sh 'node --version'
      }
    }
    stage('testing') {
      steps {
        echo '"hello world"'
      }
    }
    stage('Node Js Application installation') {
      steps {
        sh 'nodejs --version'
      }
    }
    stage('install dependecies') {
      steps {
        sh 'npm install'
      }
    }
  }
}
